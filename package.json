{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npx tsx scripts/generate-sitemap.ts && vite build && npx tsx scripts/prerender-guides.tsx && npx tsx scripts/prerender-homepage.tsx && npx tsx scripts/prerender-legal-pages.tsx && npx tsx scripts/prerender-counties.tsx && rm -rf dist/.vite && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "outreach:dry-run": "tsx scripts/send-vendor-outreach.ts",
    "outreach:send": "SEND=true tsx scripts/send-vendor-outreach.ts",
    "admin:generate-totp-secret": "tsx scripts/generate-admin-totp-secret.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.6",
    "@clerk/clerk-react": "^5.61.3",
    "@google/genai": "^2.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@paypal/paypal-server-sdk": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-error-boundary": "^6.1.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
