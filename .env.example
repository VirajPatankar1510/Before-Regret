# ==============================================================================
# BeforeRegret - PRODUCTION ENVIRONMENT VARIABLES & SECRETS VAULT
# ==============================================================================
# IMPORTANT SECURITY WARNING:
# Do NOT commit live/production API keys, private certificates, or secret values 
# directly into this repository or any client-side codebase.
#
# Instead, store these variables securely inside your cloud hosting environment's 
# native secrets manager (e.g., Google Cloud Run Secrets, GCP Secret Manager, or 
# GitHub Repository Secrets for CI/CD deployment pipelines).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# APP_URL: The public production URL where the application is hosted.
# AI Studio / Cloud Run automatically injects this at runtime.
APP_URL="https://before-regret.com"

# NODE_ENV: Set to 'production' for optimal performance in live deployments.
NODE_ENV="production"


# ------------------------------------------------------------------------------
# 2. GEMINI AI SERVICE
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for executing server-side Gemini LLM capabilities.
# In production, inject this securely using Cloud Run / Secret Manager.
GEMINI_API_KEY="YOUR_SECURE_GEMINI_API_KEY"


# ------------------------------------------------------------------------------
# 4. CLERK AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Set your Clerk Publishable Key here. You can get this from your Clerk Dashboard:
# https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY="pk_test_YW11c2luZy1nYXplbGxlLTQ4LmNsZXJrLmFjY291bnRzLmRldiQ"
CLERK_SECRET_KEY="YOUR_CLERK_SECRET_KEY"


# ------------------------------------------------------------------------------
# 6. EXTERNAL MAPS / LOCATION SERVICES
# ------------------------------------------------------------------------------
# LOCATIONIQ_API_KEY: Powers map search-as-you-type and click/drag-to-address (server-side
# proxy at /api/geocode/search and /api/geocode/reverse in server.ts). Get a free key at
# https://locationiq.com (5,000 requests/day free tier as of this writing). Do NOT remove the
# server-side proxy and call LocationIQ (or Nominatim) directly from the browser -- that would
# expose this key in client-side network requests.
LOCATIONIQ_API_KEY="YOUR_LOCATIONIQ_API_KEY"

# MAPMYINDIA / MAPPLS API CREDENTIALS:
# Used for address matching and neighborhood spatial queries.
MAPMYINDIA_CLIENT_ID="YOUR_MAPMYINDIA_CLIENT_ID"
MAPMYINDIA_CLIENT_SECRET="YOUR_MAPMYINDIA_CLIENT_SECRET"


# ------------------------------------------------------------------------------
# 7. ADMIN ACCESS (/admin/seo and future admin screens)
# ------------------------------------------------------------------------------
# Both must be set or the admin area stays locked for everyone -- including you. That is
# deliberate: /admin/seo was previously reachable by anyone on the internet, and a missing
# environment variable must never silently mean "open to the public".
#
# ADMIN_PASSWORD: the password you type on the /admin/seo sign-in screen.
ADMIN_PASSWORD="CHOOSE_A_STRONG_PASSWORD"
#
# ADMIN_SESSION_SECRET: any long random string. Used to sign the sign-in cookie so it can't be
# forged. Generate one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET="GENERATE_A_LONG_RANDOM_STRING"


# ------------------------------------------------------------------------------
# 8. ARTICLES DATABASE (Neon Postgres)
# ------------------------------------------------------------------------------
# DATABASE_URL: Postgres connection string from your Neon project dashboard. Backs the real
# article save/publish path at /api/admin/articles and the public /api/guides/:slug read path
# (see src/server/db.ts, src/server/articlesApi.ts). Without this set, admin article routes
# return 503 and public guide pages 404 -- same fail-closed pattern as ADMIN_PASSWORD above,
# rather than a silent fallback to fake data.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"


# ------------------------------------------------------------------------------
# 9. PAYPAL PAYMENT PROCESSING
# ------------------------------------------------------------------------------
# PAYPAL_CLIENT_ID: Your PayPal application client ID. Get this from your PayPal Developer Dashboard:
# https://developer.paypal.com/dashboard
PAYPAL_CLIENT_ID="YOUR_PAYPAL_CLIENT_ID"

# PAYPAL_CLIENT_SECRET: Your PayPal application secret. Keep this secure and never expose in client-side code.
PAYPAL_CLIENT_SECRET="YOUR_PAYPAL_CLIENT_SECRET"

# PAYPAL_MODE: Set to 'sandbox' for testing or 'live' for production.
# Start with 'sandbox' to test the integration before going live.
PAYPAL_MODE="sandbox"
