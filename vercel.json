{
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/shell.html"
    }
  ],
  "crons": [
    {
      "path": "/api/admin/county-events/check",
      "schedule": "0 13 * * *"
    }
  ]
}
