{
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
