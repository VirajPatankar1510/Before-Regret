node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
scripts/outreach-log.json
scripts/draft-topics-log.json
.cache/
# Scratch output from the repo's own tooling -- the article-faqs skill's .tmp-faq-batch.txt /
# .tmp-faq-draft.json, and scripts/serp-batch-test.ts's two comparison files. All are working
# artefacts read once and thrown away; none belong in a commit.
.tmp-*

# Database backups written by scripts/backup-db.ts. Contain real user data
# (transactions, terms acceptances, generated reports) -- never commit them.
backups/

# Office lock files. Word writes ~$name.docx beside a document while it is open, and a
# `git add -A` run during that window commits it. One reached the repo in 94baad9 this way.
~$*
.~lock.*#

# Customer correspondence drafts: these contain real names, email addresses and home
# addresses, and this repository is public. Never commit them.
docs/reply-*.md
