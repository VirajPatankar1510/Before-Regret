{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "server.ts",
    "scripts/*.ts",
    "scripts/*.tsx",
    "vite.config.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{ts,tsx}",
    "server.ts"
  ],
  "ignoreDependencies": [
    "@tailwindcss/vite",
    "@vitejs/plugin-react",
    "autoprefixer",
    "tailwindcss",
    "vite"
  ],
  "ignore": [
    "src/vite-env.d.ts"
  ]
}
